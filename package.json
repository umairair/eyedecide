{
  "name": "eyedecide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A higher-or-lower game you play entirely with your head and eyes.",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-model": "node scripts/fetch-model.mjs",
    "data": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "flag-icons": "7.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
